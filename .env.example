# Public site URL (used for canonical and og tags)
VITE_SITE_URL=https://playlog.io
# Optional. When set, LeadForm POSTs JSON to this endpoint (e.g. a Next.js API route that emails info@playlog.io).
# When empty, submitLead() runs as a local stub and logs the payload to the console.
VITE_LEAD_ENDPOINT=
